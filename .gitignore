# Deny by default: only reviewed application source and deployment metadata.
*
!.gitignore
!.vercelignore
!.gitattributes
!README.md
!README.zh-CN.md
!index.py
!pyproject.toml
!requirements.txt
!vercel.json
!src/
!src/**/
!src/**/*.py
!src/ashare_research/auction_web.html

# Always exclude credentials, local state, generated output and binary data.
**/.env
**/.env.*
**/*.env
**/.aws/
**/.ssh/
**/.vercel/
**/*credential*
**/*secret*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/env/
**/node_modules/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage*
**/htmlcov/
**/data/
**/output/
**/outputs/
**/runtime/
**/logs/
**/tests/
**/.work/
**/configs/
**/*.db
**/*.sqlite*
**/*.csv
**/*.parquet
**/*.jsonl
**/*.log
**/*.zip
**/*.tar*
**/*.bak
**/*.tmp
**/.DS_Store
**/Thumbs.db
